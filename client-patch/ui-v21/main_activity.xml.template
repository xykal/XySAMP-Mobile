<?xml version="1.0" encoding="utf-8"?>
<!-- Lombok Holiday v3.1 UI: sidebar kiri (landscape), konten kanan. Semua ukuran dp/sp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060A14">

    <!-- Background gambar senja + scrim gelap agar konten tetap terbaca -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/lh_bg" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C060A14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

    <!-- SIDEBAR -->
    <com.samp.mobile.launcher.SidebarLayout
        android:id="@+id/sidebar"
android:layout_width="@dimen/lh_sidebar_width"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_sidebar"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">
        <ImageButton
            android:id="@+id/btnSidebarToggle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="Perkecil atau besarkan sidebar"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_logo_badge"
                android:clipToOutline="true"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lombok Holiday"
                    android:textColor="#F8FAFC"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/title2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROLEPLAY CLIENT"
                    android:textColor="#38BDF8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:text="MENU"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <Button android:id="@+id/tabBtnHome" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="0dp" android:background="@drawable/nav_item_selected"
            android:gravity="start|center_vertical" android:paddingStart="14dp" android:paddingEnd="10dp"
            android:minHeight="0dp" android:minWidth="0dp"
            android:text="Beranda" android:textColor="#F1F5F9" android:textSize="14sp"
            android:textStyle="bold" android:textAllCaps="false" />
        <Button android:id="@+id/tabBtnServers" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="6dp" android:background="@drawable/nav_item"
            android:gravity="start|center_vertical" android:paddingStart="14dp" android:paddingEnd="10dp"
            android:minHeight="0dp" android:minWidth="0dp"
            android:text="Daftar Server" android:textColor="#F1F5F9" android:textSize="14sp"
            android:textStyle="normal" android:textAllCaps="false" />
        <Button android:id="@+id/tabBtnNews" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="6dp" android:background="@drawable/nav_item"
            android:gravity="start|center_vertical" android:paddingStart="14dp" android:paddingEnd="10dp"
            android:minHeight="0dp" android:minWidth="0dp"
            android:text="Berita &amp; Update" android:textColor="#F1F5F9" android:textSize="14sp"
            android:textStyle="normal" android:textAllCaps="false" />
        <Button android:id="@+id/tabBtnMods" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="6dp" android:background="@drawable/nav_item"
            android:gravity="start|center_vertical" android:paddingStart="14dp" android:paddingEnd="10dp"
            android:minHeight="0dp" android:minWidth="0dp"
            android:text="Mod Center" android:textColor="#F1F5F9" android:textSize="14sp"
            android:textStyle="normal" android:textAllCaps="false" />
        <Button android:id="@+id/tabBtnSettings" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="6dp" android:background="@drawable/nav_item"
            android:gravity="start|center_vertical" android:paddingStart="14dp" android:paddingEnd="10dp"
            android:minHeight="0dp" android:minWidth="0dp"
            android:text="Pengaturan" android:textColor="#F1F5F9" android:textSize="14sp"
            android:textStyle="normal" android:textAllCaps="false" />
        <Button android:id="@+id/tabBtnControls" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="6dp" android:background="@drawable/nav_item"
            android:gravity="start|center_vertical" android:paddingStart="14dp" android:paddingEnd="10dp"
            android:minHeight="0dp" android:minWidth="0dp"
            android:text="Kontrol" android:textColor="#F1F5F9" android:textSize="14sp"
            android:textStyle="normal" android:textAllCaps="false" />
        <Button android:id="@+id/tabBtnToys" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="6dp" android:background="@drawable/nav_item"
            android:gravity="start|center_vertical" android:paddingStart="14dp" android:paddingEnd="10dp"
            android:minHeight="0dp" android:minWidth="0dp"
            android:text="Toys" android:textColor="#F1F5F9" android:textSize="14sp"
            android:textStyle="normal" android:textAllCaps="false" />
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/authorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Lombok Holiday  •  v2.1.0"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </com.samp.mobile.launcher.SidebarLayout>

    <!-- KONTEN KANAN -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/lh_content_pad"
            android:paddingEnd="@dimen/lh_content_pad"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Selamat datang kembali"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/abiBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="ABI: ARM64 / ARMv7"
                android:textColor="#7DD3FC"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
    <ScrollView android:id="@+id/panelHome" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none" android:visibility="visible">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/lh_content_pad" android:paddingEnd="@dimen/lh_content_pad" android:paddingTop="12dp" android:paddingBottom="24dp">
            <ViewFlipper
                android:id="@+id/bannerFlipper"
                android:clipToOutline="true"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@drawable/bg_banner"
                android:measureAllChildren="false" />

            <TextView
                android:id="@+id/bannerIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_gravity="center_horizontal"
                android:text="● ○ ○"
                android:textColor="#38BDF8"
                android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:layout_marginBottom="6dp"
                    android:text="SERVER TERPILIH" android:textColor="#38BDF8" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.14" />
<TextView android:id="@+id/homeServerText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:text="Lombok Holiday Roleplay" android:textColor="#F1F5F9"
                    android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/homeServerStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="○  Memeriksa server..." android:textColor="#94A3B8" android:textSize="12sp" android:textStyle="bold" />
<Button android:id="@+id/btnOpenServers" android:layout_width="match_parent" android:layout_height="42dp"
                    android:layout_marginTop="12dp" android:background="@drawable/bg_button_muted"
                    android:text="KELOLA SERVER" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:layout_marginBottom="6dp"
                    android:text="AKUN ROLEPLAY &amp; KONEKSI" android:textColor="#38BDF8" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.14" />
            <EditText android:id="@+id/nicknameInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:hint="Nickname (Nama_Roleplay)"
                android:textColorHint="#64748B" android:textColor="#F8FAFC" android:textSize="15sp"
                android:singleLine="true" android:padding="14dp" />
            <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Password Server (Opsional)"
                android:textColorHint="#64748B" android:textColor="#F8FAFC" android:textSize="15sp"
                android:inputType="textPassword" android:singleLine="true" android:padding="14dp" />
<Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="14dp" android:background="@drawable/bg_button_primary"
                    android:text="MASUK GAME" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:layout_marginBottom="6dp"
                    android:text="MANAJER DATA GTA:SA" android:textColor="#38BDF8" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.14" />
            <TextView android:id="@+id/dataBadgeStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_success" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="5dp" android:paddingBottom="5dp" android:text="MENGECEK DATA..."
                android:textColor="#34D399" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/bugText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Mendeteksi direktori data GTA..." android:textColor="#94A3B8" android:textSize="12sp" />
            <LinearLayout android:id="@+id/cardDataReady" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:orientation="vertical" android:layout_marginTop="10dp"
                android:background="@drawable/bg_banner" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DATA SIAP DIMAINKAN" android:textColor="#34D399" android:textSize="12sp"
                    android:textStyle="bold" android:letterSpacing="0.08" />
                <TextView android:id="@+id/dataReadyInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="" android:textColor="#CBD5E1" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnReadyRepair" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                        android:background="@drawable/bg_button_blue" android:text="PERBAIKI DATA" android:textColor="#FFFFFF"
                        android:textSize="12sp" android:textStyle="bold" android:textAllCaps="false"
                        android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                    <Button android:id="@+id/btnChangeData" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
                        android:layout_marginStart="8dp" android:background="@drawable/bg_button_muted" android:text="GANTI DATA"
                        android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:textAllCaps="false"
                        android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/groupDownload" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
            <ProgressBar android:id="@+id/downloadProgressBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp"
                android:max="100" android:progress="0" android:progressTint="#38BDF8" android:progressBackgroundTint="#1E293B" />
            <TextView android:id="@+id/downloadStatusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Siap mengunduh data langsung di dalam aplikasi (Auto-Extract)."
                android:textColor="#94A3B8" android:textSize="12sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal">
<Button android:id="@+id/btnDownloadLite" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
                    android:layout_marginTop="0dp" android:background="@drawable/bg_button_blue"
                    android:text="DATA LITE" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
<Button android:id="@+id/btnDownloadFull" android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
                    android:layout_marginTop="0dp" android:background="@drawable/bg_button_purple"
                    android:text="DATA FULL" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                </LinearLayout>
<Button android:id="@+id/btnCustomUrl" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_button_muted"
                    android:text="URL ZIP CUSTOM" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
<Button android:id="@+id/btnRepairData" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_button_idle"
                    android:text="PERBAIKI DATA" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
            </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="BERITA TERBARU" android:textColor="#38BDF8" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.14" />
                <Button android:id="@+id/btnOpenNews" android:layout_width="wrap_content" android:layout_height="36dp"
                    android:background="@drawable/bg_button_idle" android:text="LIHAT SEMUA" android:textColor="#E2E8F0"
                    android:textSize="11sp" android:textStyle="bold" android:textAllCaps="false" android:minHeight="0dp" android:minWidth="0dp"
                    android:paddingStart="12dp" android:paddingEnd="12dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/homeNewsContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="vertical" />
    </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/panelServers" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/lh_content_pad" android:paddingEnd="@dimen/lh_content_pad" android:paddingTop="12dp" android:paddingBottom="24dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:text="Daftar Server" android:textColor="#F1F5F9"
                    android:textSize="18sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Pilih server untuk bermain, atau tambahkan domain/IP dan port milikmu. Server tersimpan di perangkat ini." android:textColor="#94A3B8"
                    android:textSize="13sp" />
            <LinearLayout android:id="@+id/serverListContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="vertical" />
<Button android:id="@+id/btnAddServer" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="12dp" android:background="@drawable/bg_button_primary"
                    android:text="＋ TAMBAH SERVER" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
    </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/panelNews" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/lh_content_pad" android:paddingEnd="@dimen/lh_content_pad" android:paddingTop="12dp" android:paddingBottom="24dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:text="Berita &amp; Update" android:textColor="#F1F5F9"
                    android:textSize="18sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Info dimuat dari konfigurasi online. Koneksi gagal tidak menghalangi launcher untuk dibuka." android:textColor="#94A3B8"
                    android:textSize="13sp" />
            <LinearLayout android:id="@+id/newsContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="vertical" />
    </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/panelToys" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/lh_content_pad" android:paddingEnd="@dimen/lh_content_pad"
        android:paddingTop="12dp" android:paddingBottom="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TOYS SERVER" android:textColor="#38BDF8" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.14" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="Aksesoris dari server (topi, tas, dll). Matikan slot yang tidak ingin tampil, atau atur bone, posisi, dan skala per slot." android:textColor="#94A3B8" android:textSize="12sp" />
    <Button android:id="@+id/btnToysReset" android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="12dp" android:background="@drawable/bg_button_muted"
        android:text="Reset semua toys" android:textColor="#F1F5F9" android:textSize="14sp" android:textAllCaps="false" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
