<CheckBox android:button="@drawable/lh_switch" android:paddingStart="10dp" android:id="@+id/cbAndroidKeyboard" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:minHeight="40dp" android:text="Gunakan Keyboard Sistem Android"
                    android:textColor="#E2E8F0" android:textSize="14sp" android:buttonTint="#38BDF8" />
<CheckBox android:button="@drawable/lh_switch" android:paddingStart="10dp" android:id="@+id/cbHpArmourText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:minHeight="40dp" android:text="Tampilkan Angka HP &amp; Armour"
                    android:textColor="#E2E8F0" android:textSize="14sp" android:buttonTint="#38BDF8" />
<CheckBox android:button="@drawable/lh_switch" android:paddingStart="10dp" android:id="@+id/cbOutfitGuns" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:minHeight="40dp" android:text="Senjata Terlihat di Badan (Outfit)"
                    android:textColor="#E2E8F0" android:textSize="14sp" android:buttonTint="#38BDF8" />
<CheckBox android:button="@drawable/lh_switch" android:paddingStart="10dp" android:id="@+id/cbRadarRect" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:minHeight="40dp" android:text="Bentuk Radar Kotak (Rect Radar)"
                    android:textColor="#E2E8F0" android:textSize="14sp" android:buttonTint="#38BDF8" />
<CheckBox android:button="@drawable/lh_switch" android:paddingStart="10dp" android:id="@+id/cbPcMoney" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:minHeight="40dp" android:text="Format Uang Gaya PC ($00000000)"
                    android:textColor="#E2E8F0" android:textSize="14sp" android:buttonTint="#38BDF8" />
<CheckBox android:button="@drawable/lh_switch" android:paddingStart="10dp" android:id="@+id/cbSkyBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:minHeight="40dp" android:text="Efek Langit HD (SkyBox)"
                    android:textColor="#E2E8F0" android:textSize="14sp" android:buttonTint="#38BDF8" />
<CheckBox android:button="@drawable/lh_switch" android:paddingStart="10dp" android:id="@+id/cbSnow" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:minHeight="40dp" android:text="Efek Salju (Winter Snow)"
                    android:textColor="#E2E8F0" android:textSize="14sp" android:buttonTint="#38BDF8" />
    </LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:orientation="horizontal">
<Button android:id="@+id/btnSaveSettings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"
                    android:layout_marginTop="0dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_button_primary"
                    android:text="SIMPAN PENGATURAN" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
<Button android:id="@+id/btnResetSettings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"
                    android:layout_marginTop="0dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_button_muted"
                    android:text="RESET DEFAULT" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
                </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/panelMods" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/lh_content_pad" android:paddingEnd="@dimen/lh_content_pad" android:paddingTop="12dp" android:paddingBottom="24dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:layout_marginBottom="6dp"
                    android:text="MOD CENTER" android:textColor="#38BDF8" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.14" />
            <TextView android:id="@+id/modRuntimeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="MonetLoader opsional untuk script Lua. CLEO hanya menerima file; runtime CLEO belum terpasang." android:textColor="#94A3B8" android:textSize="13sp" />
<CheckBox android:button="@drawable/lh_switch" android:paddingStart="10dp" android:id="@+id/cbMonetLoaderEnabled" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:minHeight="40dp" android:text="Aktifkan MonetLoader saat memulai game (eksperimental)"
                    android:textColor="#E2E8F0" android:textSize="14sp" android:buttonTint="#38BDF8" />
<Button android:id="@+id/btnImportLua" android:layout_width="match_parent" android:layout_height="46dp"
                    android:layout_marginTop="10dp" android:background="@drawable/bg_button_blue"
                    android:text="IMPORT SCRIPT MONETLOADER (.lua / .luac)" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
<Button android:id="@+id/btnImportCleo" android:layout_width="match_parent" android:layout_height="46dp"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_button_muted"
                    android:text="SALIN SCRIPT CLEO ANDROID (.csa / .csi)" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
            <TextView android:id="@+id/modStoragePath" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:padding="12dp" android:background="@drawable/bg_info" android:text="Folder mod akan disiapkan saat fitur dipakai." android:textColor="#CBD5E1" android:textSize="12sp" />
<Button android:id="@+id/btnClearTemp" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_button_idle"
                    android:text="BERSIHKAN FILE SEMENTARA" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:text="Catatan: script Lua/mod dapat menjalankan kode dan mengubah perilaku game; instal hanya dari sumber tepercaya. CLEO .csa/.csi hanya disalin ke folder Android/media; runtime CLEO untuk build ini belum diverifikasi. File Windows .dll tidak kompatibel dengan Android (gunakan .so yang memang dibuat untuk Android/ABI yang sesuai)." android:textColor="#94A3B8"
                    android:textSize="13sp" />
    </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/panelControls" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/lh_content_pad" android:paddingEnd="@dimen/lh_content_pad" android:paddingTop="12dp" android:paddingBottom="24dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:layout_marginBottom="6dp"
                    android:text="KONTROL PERANGKAT" android:textColor="#38BDF8" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.14" />
            <TextView android:id="@+id/peripheralStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:padding="12dp" android:background="@drawable/bg_button_idle" android:text="Memindai perangkat USB OTG / Bluetooth..." android:textColor="#E2E8F0" android:textSize="13sp" />
<CheckBox android:button="@drawable/lh_switch" android:paddingStart="10dp" android:id="@+id/cbEnableKeyboardMouse" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:minHeight="40dp" android:text="Aktifkan Kontrol Keyboard Fisik (WASD + Chat T/F6) &amp; Mouse (Klik Kiri/Kanan)"
                    android:textColor="#E2E8F0" android:textSize="14sp" android:buttonTint="#38BDF8" />
<CheckBox android:button="@drawable/lh_switch" android:paddingStart="10dp" android:id="@+id/cbEnableGamepad" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:minHeight="40dp" android:text="Aktifkan Kontrol Gamepad / Joystick (PS4, PS5, Xbox, MOGA, USB/BT Pad)"
                    android:textColor="#E2E8F0" android:textSize="14sp" android:buttonTint="#38BDF8" />
<TextView android:id="@+id/lblMouseSens" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="-" android:textColor="#E2E8F0" android:textSize="13sp" />
<SeekBar android:id="@+id/seekMouseSens" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="28" android:minHeight="34dp" android:splitTrack="false"
                    android:progressDrawable="@drawable/lh_seek_progress" android:thumb="@drawable/lh_seek_thumb"
                    android:thumbOffset="11dp" />
<Button android:id="@+id/btnRefreshDevices" android:layout_width="match_parent" android:layout_height="46dp"
                    android:layout_marginTop="10dp" android:background="@drawable/bg_button_blue"
                    android:text="SCAN ULANG PERANGKAT" android:textColor="#FFFFFF" android:textSize="13sp"
                    android:textStyle="bold" android:textAllCaps="false" android:letterSpacing="0.04"
                    android:minHeight="0dp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" android:orientation="vertical"
        android:background="@drawable/bg_card" android:padding="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" android:layout_marginBottom="6dp"
                    android:text="PANDUAN TOMBOL" android:textColor="#38BDF8" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.14" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingMultiplier="1.15" android:text="• Multi-sentuh 4 jari aktif: gerakan, kamera, dan aksi dapat digunakan bersamaan (tergantung dukungan layar/perangkat)." android:textColor="#94A3B8" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingMultiplier="1.2" android:text="• Keyboard Fisik: WASD = Jalan/Setir | Space = Lompat/Rem | Shift = Lari | F / Enter = Masuk Kendaraan | C = Jongkok | H = Klakson | Q/E = Ganti Senjata | T / F6 / &apos;/&apos; = Buka Chat SA-MP | ESC = Menu/Kembali" android:textColor="#CBD5E1" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingMultiplier="1.2" android:text="• Mouse OTG/BT: Klik Kiri = Tembak/Pukul | Klik Kanan = Bidik (Aim) | Scroll = Ganti Senjata | Klik Tengah = Lihat Belakang" android:textColor="#CBD5E1" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingMultiplier="1.2" android:text="• Gamepad: Analog Kiri = Gerak | Analog Kanan = Kamera | R2/B = Tembak | L2/R1 = Bidik | Y/Segitiga = Kendaraan | A/Silang = Lari | X/Kotak = Lompat" android:textColor="#CBD5E1" android:textSize="12sp" />
    </LinearLayout>

        </LinearLayout>
    </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
