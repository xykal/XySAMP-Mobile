<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#0B1426" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/lh_bg" android:gravity="center" android:tileMode="disabled" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1A060A14" android:endColor="#E6060A14" android:angle="270" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
