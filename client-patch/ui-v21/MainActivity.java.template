    private File getPreferredWritableDataDir() {
        try {
            File ext = getExternalFilesDir(null);
            if (ext != null) {
                if (!ext.exists()) ext.mkdirs();
                return ext;
            }
        } catch (Exception ignored) {}
        File gta = new File("/storage/emulated/0/GTA/");
        if (!gta.exists()) gta.mkdirs();
        return gta;
