                boolean allGranted = true;
                for (Boolean granted : permissions.values()) {
                    if (!granted) {
                        allGranted = false;
                        break;
                    }
                }
                if (allGranted) {
                    storagePermissionGranted = true;
                    onPermissionReady();
                } else {
                    storagePermissionGranted = true; // App-specific external files dir tetap bisa diakses tanpa izin di Android 10+
                    onPermissionReady();
                }
            });

