FontSize=30
FontOutline=2
ChatPosX=325
ChatPosY=25
ChatSizeX=1150
ChatSizeY=220
ChatMaxMessages=7
FPSLimit=60
VoiceChatEnable=true
androidkeyboard=false
firstperson=true
cutout=true
fps=true
hparmourtext=true
outfitguns=true
radarrect=false
pcmoney=false
skybox=false
snow=false
Dialog=true
