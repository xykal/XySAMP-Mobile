; ============================================================
;  settings.ini - contoh config client SA-MP Mobile (khusus)
;  Lokasi asli di HP: /storage/emulated/0/GTA/SAMP/settings.ini
;
;  CATATAN: kalau client udah dipatch pake lockdown.py (LOCK_ALLOW_INI_OVERRIDE = 0),
;  nilai host / port / version di bawah ini DIABAIKAN - yang kepake nilai
;  yang nempel di APK. Ini cuma referensi / buat mode debug.
; ============================================================

[client]
name=Player
host=play.serverlu.com
port=1417
password=
version=MYSRV-1.7
autoaim=false

[debug]
debug=false
online=true

[gui]
Font=arial.ttf
FontSize=30
FontOutline=2
ChatPosX=325
ChatPosY=25
ChatSizeX=1150
ChatSizeY=220
ChatMaxMessages=6
Dialog=true
