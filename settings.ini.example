; Contoh settings.ini Lombok Holiday
; Launcher akan menulis host/port dari server yang dipilih di Daftar Server.
; File aktif disimpan di folder data game aplikasi /SAMP/settings.ini (tanpa OBB).

[client]
name=Player_Lombok
host=play.lombokholiday.my.id
port=7777
password=
version=0.3.7
autoaim=false

[debug]
debug=false
online=true

[gui]
